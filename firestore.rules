rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==============================
    // SUPER ADMIN
    // ==============================
    match /admins/{adminId} {

      // Admin zai iya karanta document ɗinsa
      allow read: if isSignedIn()
                  && request.auth.uid == adminId;

      // Super Admin zai iya ƙirƙira, gyara ko goge admins
      allow write: if isSuperAdmin();
    }


    // ==============================
    // USERS
    // ==============================
    match /users/{userId} {

      allow read: if true;

      allow create: if isSignedIn()
                    && request.auth.uid == userId;

      allow update: if isSuperAdmin()
                    || (
                      isSignedIn()
                      && request.auth.uid == userId
                      && !request.resource.data.diff(resource.data).affectedKeys()
                            .hasAny(['verified', 'verifiedAt', 'verifiedBy'])
                    );

      allow delete: if isSuperAdmin()
                    || (
                      isSignedIn()
                      && request.auth.uid == userId
                    );
    }


    // ==============================
    // PRODUCTS
    // ==============================
    match /products/{productId} {

      allow read: if true;

      allow create: if isSignedIn();

      allow update: if isSuperAdmin()
                    || (
                      isSignedIn()
                      && resource.data.sellerId == request.auth.uid
                    )
                    || (
                      // Yarda wa duk mai Login ya sabunta KAWAI
                      // avgRating/reviewCount, sakamakon barin review.
                      // Ba zai iya taɓa wani field dabam ba (price,
                      // name, sellerId, da dai sauransu).
                      isSignedIn()
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['avgRating', 'reviewCount'])
                    );

      allow delete: if isSuperAdmin()
                    || (
                      isSignedIn()
                      && resource.data.sellerId == request.auth.uid
                    );
    }


    // ==============================
    // REVIEWS
    // ==============================
    match /reviews/{reviewId} {

      // Kowa (ko da ba Login ba) yana iya karanta reviews
      allow read: if true;

      // Signed-in buyer kaɗai zai iya aika review, kuma
      // dole buyerId ya zama nasa uid, rating tsakanin 1-5.
      allow create: if isSignedIn()
                    && request.resource.data.buyerId == request.auth.uid
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5;

      // Reviews ba za a iya gyarawa ba bayan an aika (kariya
      // daga cin zarafi/canza rating bayan an lissafa avgRating).
      allow update: if false;

      // Super Admin kaɗai zai iya goge review (misali bayan report).
      allow delete: if isSuperAdmin();
    }


    // ==============================
    // CATEGORIES
    // ==============================
    match /categories/{categoryId} {

      allow read: if true;

      allow write: if isSuperAdmin();
    }


    // ==============================
    // LOCATIONS
    // ==============================
    match /locations/{locationId} {

      allow read: if true;

      allow write: if isSuperAdmin();
    }


    // ==============================
    // REPORTS
    // ==============================
    match /reports/{reportId} {

      allow create: if isSignedIn();

      allow read, update, delete: if isSuperAdmin();
    }


    // ==============================
    // MESSAGES / CONVERSATIONS
    // ==============================

    match /conversations/{conversationId} {

      allow read: if isSignedIn()
                  && request.auth.uid in resource.data.participantIds;

      allow create: if isSignedIn()
                    && request.auth.uid in request.resource.data.participantIds
                    && request.resource.data.participantIds.size() == 2;

      allow update: if isSignedIn()
                    && request.auth.uid in resource.data.participantIds
                    && request.auth.uid in request.resource.data.participantIds;

      allow delete: if false;


      // ==============================
      // MESSAGES
      // ==============================
      match /messages/{messageId} {

        allow read: if isSignedIn()
                    && request.auth.uid in get(
                      /databases/$(database)/documents/conversations/$(conversationId)
                    ).data.participantIds;

        allow create: if isSignedIn()
                      && request.auth.uid == request.resource.data.senderId
                      && request.auth.uid in get(
                        /databases/$(database)/documents/conversations/$(conversationId)
                      ).data.participantIds
                      && request.resource.data.receiverId in get(
                        /databases/$(database)/documents/conversations/$(conversationId)
                      ).data.participantIds;

        allow update: if isSignedIn()
                      && request.auth.uid in get(
                        /databases/$(database)/documents/conversations/$(conversationId)
                      ).data.participantIds;

        allow delete: if false;
      }
    }


    // ==============================
    // PREMIUM SETTINGS
    // ==============================
    match /premiumSettings/{settingId} {

      allow read: if true;

      allow write: if isSuperAdmin();
    }
    // ==============================
    // PREMIUM SETTINGS
    // ==============================
    match /premiumSettings/{settingId} {

      allow read: if true;

      allow write: if isSuperAdmin();
    }


    // ==============================
    // FEATURED SETTINGS
    // ==============================
    match /featuredSettings/{settingId} {

      allow read: if true;

      allow write: if isSuperAdmin();
    }


    // ==============================
    // PREMIUM REQUESTS
    // ==============================


    // ==============================
    // PREMIUM REQUESTS
    // ==============================
    match /premiumRequests/{requestId} {

      allow create: if isSuperAdmin()
                    || (
                      isSignedIn()
                      && request.resource.data.sellerId == request.auth.uid
                    );

      allow read: if isSuperAdmin()
                  || (
                    isSignedIn()
                    && resource.data.sellerId == request.auth.uid
                  );

      allow update, delete: if isSuperAdmin();
    }
    
// ==============================
    // FEATURED REQUESTS
    // ==============================
    match /featuredRequests/{requestId} {

      allow create: if isSuperAdmin()
                    || (
                      isSignedIn()
                      && request.resource.data.sellerId == request.auth.uid
                    );

      allow read: if isSuperAdmin()
                  || (
                    isSignedIn()
                    && resource.data.sellerId == request.auth.uid
                  );

      allow update, delete: if isSuperAdmin();
    }

    // ==============================
    // COMMISSIONS
    // ==============================
    match /commissions/{commissionId} {

      allow read: if isSuperAdmin()
                  || (
                    isSignedIn()
                    && resource.data.referrerId == request.auth.uid
                  );

      allow write: if isSuperAdmin();
    }


    // ==============================
    // WITHDRAWAL REQUESTS
    // ==============================
    match /withdrawalRequests/{requestId} {

      allow create: if isSignedIn()
                    && request.resource.data.sellerId == request.auth.uid;

      allow read: if isSuperAdmin()
                  || (
                    isSignedIn()
                    && resource.data.sellerId == request.auth.uid
                  );

      allow update, delete: if isSuperAdmin();
    }


    // ==============================
    // REFERRAL SETTINGS
    // ==============================
    match /referralSettings/{settingId} {

      // Kowa (seller/buyer) yana bukatar karanta wannan
      // domin ganin minimum withdrawal da commission %.
      allow read: if true;

      // Super Admin kawai zai iya ƙirƙira/gyara/goge
      allow write: if isSuperAdmin();
    }


    // ==============================
    // HELPER FUNCTIONS
    // ==============================

    function isSignedIn() {
      return request.auth != null;
    }


    function isSuperAdmin() {

      return isSignedIn()

        && exists(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        )

        && get(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        ).data.role == "superAdmin"

        && get(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        ).data.active == true;
    }
  }
}
